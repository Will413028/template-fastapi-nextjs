# Copied to .env by `make init-env`, which also creates the secret files under .secrets/: the database passwords and
# origin_secret, the backend's ORIGIN_SECRET. Secrets never go in this file: compose mounts .secrets/* as secrets and
# services read them via <KEY>_FILE. Vercel's ORIGIN_SECRET environment variable holds the same value as
# .secrets/origin_secret; to rotate it, write "new,old" to the file, restart the backend, change Vercel's value, then
# write "new" alone.

# PostgreSQL: the superuser initializes the volume; migrate uses the owner role, the backend the app role
# (deploy/postgres/initdb/10-roles.sh). Roles are created only when the volume is first initialized.
POSTGRES_USER=postgres
POSTGRES_DB=template_fastapi_nextjs
DB_OWNER_USER=template_fastapi_nextjs_owner
DB_APP_USER=template_fastapi_nextjs_app

# Backend
# MODE: dev (text logs; serves the API contract at /api/openapi.yaml and Swagger UI at /api/docs) or prod
# (JSON logs, no docs). Unset means prod, so only a local setup opts into dev.
MODE=dev
# Session lifetime; SESSION_IDLE must not exceed SESSION_ABSOLUTE
SESSION_ABSOLUTE=168h
SESSION_IDLE=24h
# COOKIE_SECURE MUST be true in production (requires HTTPS). false names the cookie `session` instead of
# `__Host-session`, for local http (Safari refuses Secure cookies on http://localhost).
COOKIE_SECURE=false
# The site's origin as browsers see it, without a trailing slash (the frontend's domain on Vercel in production)
APP_ORIGIN=http://localhost:3000
# DB_MAX_CONNS=20
# DB_STATEMENT_TIMEOUT=5s
# AUTH_RATE_LIMIT_PER_MIN=5
# PASSWORD_HIBP_CHECK=false

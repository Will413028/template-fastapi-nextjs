# Only needed when running the frontend standalone (pnpm dev) outside Docker.
# In the Docker stack these come from the root .env via docker-compose.

# Public site URL (used by sitemap.ts / robots.ts)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The backend, for server-side (SSR/RSC) calls and for the /api rewrite of
# pnpm dev. The browser never calls it directly: it uses /api on its own origin.
# On Vercel it is the backend's public origin through the Cloudflare Tunnel, the
# same as BACKEND_ORIGIN, which vercel.json's /api rewrite uses.
API_URL=http://localhost:8000

# The backend's ORIGIN_SECRET (.secrets/origin_secret on the VM), sent by
# server-side calls and added by vercel.json's rewrite. Set it only on Vercel,
# never with a NEXT_PUBLIC_ prefix; a local backend in MODE=dev needs none.
# ORIGIN_SECRET=

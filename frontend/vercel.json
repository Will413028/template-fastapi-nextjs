{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "${BACKEND_ORIGIN}/api/$1",
      "env": ["BACKEND_ORIGIN"],
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "X-Origin-Secret" },
          "args": "$ORIGIN_SECRET",
          "env": ["ORIGIN_SECRET"]
        }
      ]
    }
  ]
}
